@page "/orders"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@using System.Globalization
@inject IOrderService OrderService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Órdenes</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Lista de Órdenes</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-primary" @onclick="CreateNew">
                            <i class="fas fa-plus me-1"></i> Nueva Orden
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="RefreshData">
                            <i class="fas fa-sync-alt me-1"></i> Actualizar
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }

                    @if (isLoading)
                    {
                        <div class="d-flex justify-content-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (orders?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Descripción</th>
                                        <th>Cliente</th>
                                        <th>Precio</th>
                                        <th>Período</th>
                                        <th>Tipo Negocio</th>
                                        <th>Estado</th>
                                        <th>Día Semana</th>
                                        <th>Tipo Orden</th>
                                        <th>Fecha Inicio</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in orders)
                                    {
                                        <tr>
                                            <td>@order.Id.ToString("N")[..8]...</td>
                                            <td>@order.Description</td>
                                            <td>@order.Customer?.Name</td>
                                            <td>@order.SellingPrice.ToString("C", new CultureInfo("es-AR"))</td>
                                            <td>@order.Period?.Name</td>
                                            <td>@order.BusinessType?.Name</td>
                                            <td>
                                                <span class="badge bg-@GetStatusBadgeColor(order.Status)">
                                                    @GetStatusText(order.Status)
                                                </span>
                                            </td>
                                            <td>@GetWeekDayText(order.WeekDay)</td>
                                            <td>@GetOrderTypeText(order.OrderType)</td>
                                            <td>@(order.OrderStartDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button type="button" class="btn btn-outline-info" @onclick="() => ViewDetails(order.Id)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-warning" @onclick="() => EditOrder(order.Id)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger" @onclick="() => DeleteOrder(order.Id)"
                                                            @onclick:preventDefault="true">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                            <h5>No hay órdenes registradas</h5>
                            <p class="text-muted">Haga clic en "Nueva Orden" para agregar la primera orden.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IEnumerable<OrderDto>? orders;
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            orders = await OrderService.GetAllOrdersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar las órdenes: {ex.Message}";
            orders = Enumerable.Empty<OrderDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadOrders();
    }

    private void CreateNew()
    {
        Navigation.NavigateTo("/orders/create");
    }

    private void ViewDetails(Guid id)
    {
        Navigation.NavigateTo($"/orders/details/{id}");
    }

    private void EditOrder(Guid id)
    {
        Navigation.NavigateTo($"/orders/edit/{id}");
    }

    private async Task DeleteOrder(Guid id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "¿Está seguro de que desea eliminar esta orden?");
        if (confirmed)
        {
            try
            {
                var result = await OrderService.DeleteOrderAsync(id);
                if (result)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Orden eliminada exitosamente!");
                    await LoadOrders();
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("showToast", "error", "Error al eliminar la orden.");
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("showToast", "error", $"Error: {ex.Message}");
            }
        }
    }

    private string GetStatusBadgeColor(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Created => "secondary",
            OrderStatus.InProgress => "warning",
            OrderStatus.Completed => "success",
            OrderStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }

    private string GetStatusText(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Created => "Creada",
            OrderStatus.InProgress => "En Progreso",
            OrderStatus.Completed => "Completada",
            OrderStatus.Cancelled => "Cancelada",
            _ => status.ToString()
        };
    }

    private string GetWeekDayText(WeekDay weekDay)
    {
        return weekDay switch
        {
            WeekDay.Monday => "Lunes",
            WeekDay.Tuesday => "Martes",
            WeekDay.Wednesday => "Miércoles",
            WeekDay.Thursday => "Jueves",
            WeekDay.Friday => "Viernes",
            WeekDay.Saturday => "Sábado",
            WeekDay.Sunday => "Domingo",
            _ => weekDay.ToString()
        };
    }

    private string GetOrderTypeText(OrderType orderType)
    {
        return orderType switch
        {
            OrderType.Product => "Producto",
            OrderType.Cash => "Efectivo",
            _ => orderType.ToString()
        };
    }
}