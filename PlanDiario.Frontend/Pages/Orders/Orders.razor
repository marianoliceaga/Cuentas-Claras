@page "/orders"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject IOrderService OrderService
@inject NavigationManager Navigation

<PageTitle>Orders</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Orders</h1>
    <button class="btn btn-primary" @onclick="CreateOrder">
        <span class="oi oi-plus" aria-hidden="true"></span> New Order
    </button>
</div>

@if (orders == null)
{
    <p><em>Cargando...</em></p>
}
else if (!orders.Any())
{
    <div class="alert alert-info">
        <h4>No orders found</h4>
        <p>Get started by creating your first order.</p>
        <button class="btn btn-primary" @onclick="CreateOrder">Create Order</button>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in orders)
                {
                    <tr>
                        <td>@order.Id.ToString("N")[..8]...</td>
                        <td>@order.Customer.Name @order.Customer.LastName</td>
                        <td>@order.Description</td>
                        <td>@order.SellingPrice.ToString("C")</td>
                        <td>
                            <span class="badge bg-@GetStatusBadgeClass(order.Status)">
                                @order.Status
                            </span>
                        </td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" @onclick="() => ViewOrder(order.Id)">
                                    <span class="oi oi-eye" aria-hidden="true"></span>
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="() => EditOrder(order.Id)">
                                    <span class="oi oi-pencil" aria-hidden="true"></span>
                                </button>
                                <button class="btn btn-outline-danger" @onclick="() => DeleteOrder(order.Id)">
                                    <span class="oi oi-trash" aria-hidden="true"></span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IEnumerable<OrderDto>? orders;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        orders = await OrderService.GetAllOrdersAsync();
    }

    private void CreateOrder()
    {
        Navigation.NavigateTo("/orders/create");
    }

    private void ViewOrder(Guid id)
    {
        Navigation.NavigateTo($"/orders/view/{id}");
    }

    private void EditOrder(Guid id)
    {
        Navigation.NavigateTo($"/orders/edit/{id}");
    }

    private async Task DeleteOrder(Guid id)
    {
        if (confirm("Are you sure you want to delete this order?"))
        {
            await OrderService.DeleteOrderAsync(id);
            await LoadOrders();
        }
    }

    private static string GetStatusBadgeClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Created => "secondary",
            OrderStatus.InProgress => "warning text-dark",
            OrderStatus.Completed => "success",
            OrderStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }

    private bool confirm(string message)
    {
        // Note: In a real implementation, you'd use a proper modal dialog
        // For simplicity, we'll just return true here
        return true;
    }
}
