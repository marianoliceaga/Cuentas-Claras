@page "/products/{id:int}"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@using System.Text.Json.Nodes
@inject IProductService ProductService
@inject NavigationManager Navigation

<PageTitle>Product Details</PageTitle>

<div class="container">
    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (product != null)
    {
        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3>Detailes de producto</h3>
                        <div>
                            <NavLink class="btn btn-warning" href="@($"/products/edit/{product.Id}")">
                                <i class="fas fa-edit"></i> Editar
                            </NavLink>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <strong>ID:</strong> @product.Id
                            </div>
                            <div class="col-md-6">
                                <strong>Precio de Venta:</strong> $@product.SalePrice.ToString("F2")
                            </div>
                            <div class="col-md-6">
                                <strong>Precio de Costo:</strong> $@product.CostPrice.ToString("F2")
                            </div>
                        </div>
                        <hr />
                        <div class="mb-3">
                            <strong>Nombre:</strong>
                            <p>@product.Name</p>
                        </div>
                        <div class="mb-3">
                            <strong>Descripción:</strong>
                            <p>@(string.IsNullOrEmpty(product.Description) ? "No tiene dedscripción" : product.Description)</p>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Subcategoría:</strong>
                                <p>@product.Subcategory?.Name</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                 <strong>Características:</strong>
                                    @if (CharacteristicsJson != null)
                                    {
                                        <JsonViewer Node="CharacteristicsJson" />
                                    }
                                    else
                                    {
                                        <p><em>No definidas</em></p>
                                    }
                                </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3 text-center">
            <NavLink class="btn btn-primary" href="/products">
                <i class="fas fa-arrow-left"></i> Vuelta a Articulos
            </NavLink>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i> Articulo no encontrado.
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ProductDto? product;
    private bool loading = true;
    private JsonNode? CharacteristicsJson;

    protected override async Task OnInitializedAsync()
    {
        var result = await ProductService.GetByIdAsync(Id);
        if (result?.Success == true)
        {
            product = result.Data;

            if (!string.IsNullOrWhiteSpace(product!.Characteristics))
            {
                try
                {
                    CharacteristicsJson = JsonNode.Parse(product.Characteristics);
                }
                catch
                {
                    CharacteristicsJson = null; // fallback if invalid JSON
                }
            }

        }
        loading = false;
    }
  
}