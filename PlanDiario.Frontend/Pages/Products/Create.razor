@page "/products/create"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject IProductService ProductService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Create Product</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header">
                    <h3>Create New Product</h3>
                </div>
                <div class="card-body">
                    @if (loading)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="createProductDto" OnValidSubmit="HandleValidSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="alert alert-danger" />

                            <div class="mb-3">
                                <label for="name" class="form-label">Name *</label>
                                <InputText id="name" class="form-control" @bind-Value="createProductDto.Name" />
                                <ValidationMessage For="@(() => createProductDto.Name)" />
                            </div>

                            <div class="mb-3">
                                <label for="description" class="form-label">Description</label>
                                <InputTextArea id="description" class="form-control" rows="3" @bind-Value="createProductDto.Description" />
                                <ValidationMessage For="@(() => createProductDto.Description)" />
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="subcategory" class="form-label">Subcategory *</label>
                                        <InputSelect id="subcategory" class="form-select" @bind-Value="createProductDto.SubcategoryId">
                                            <option value="">Select a subcategory</option>
                                            @if (subcategories?.Any() == true)
                                            {
                                                @foreach (var subcategory in subcategories)
                                                {
                                                    <option value="@subcategory.Id">@subcategory.Name (@subcategory.Category.Name)</option>
                                                }
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => createProductDto.SubcategoryId)" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="price" class="form-label">Price</label>
                                        <InputNumber id="price" class="form-control" @bind-Value="createProductDto.CostPrice" step="1.00" />
                                        <ValidationMessage For="@(() => createProductDto.CostPrice)" />
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between">
                                <NavLink type="button" class="btn btn-secondary" href="/products">
                                    <i class="fas fa-arrow-left"></i> Vuelta a Artículos
                                </NavLink> 
                                <button type="submit" class="btn btn-primary" disabled="@submitting">
                                    @if (submitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="fas fa-save"></i> Crear Articulo
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateProductDto createProductDto = new();
    private List<SubcategoryDto> subcategories = new();
    private bool loading = true;
    private bool submitting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubcategories();
    }

    private async Task LoadSubcategories()
    {
        var result = await ProductService.GetSubcategoriesAsync();
        if (result?.Success == true && result.Data != null)
        {
            subcategories = result.Data;
        }
        loading = false;
    }

    private async Task HandleValidSubmit()
    {
        submitting = true;
        var result = await ProductService.CreateAsync(createProductDto);

        if (result?.Success == true)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Product created successfully!");
            Navigation.NavigateTo("/products");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error creating product: {result?.Message}");
        }

        submitting = false;
    }
}