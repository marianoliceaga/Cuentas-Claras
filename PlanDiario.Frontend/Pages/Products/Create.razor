@page "/products/create"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@using System.Text.Json.Nodes
@using System.Text.Json
@inject IProductService ProductService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Create Product</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header">
                    <h3>Crear Nuevo Artículo</h3>
                </div>
                <div class="card-body">
                    @if (loading)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="createProductDto" OnValidSubmit="HandleValidSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="alert alert-danger" />

                            <div class="mb-3">
                                <label for="name" class="form-label">Nombre *</label>
                                <InputText id="name" class="form-control" @bind-Value="createProductDto.Name" />
                                <ValidationMessage For="@(() => createProductDto.Name)" />
                            </div>

                            <div class="mb-3">
                                <label for="description" class="form-label">Descripción</label>
                                <InputTextArea id="description" class="form-control" rows="3" @bind-Value="createProductDto.Description" />
                                <ValidationMessage For="@(() => createProductDto.Description)" />
                            </div>

                            <div class="mb-3">
                                <label for="description" class="form-label">Características</label>
                                <JsonEditor Node="Root" OnChanged="UpdateJson" />

                                <br />
                                <button class="btn btn-primary" @onclick="Save">Guardar Características</button>

                                @if (!string.IsNullOrEmpty(JsonOutput))
                                {
                                    <h4>JSON Resultante</h4>
                                    <pre>@JsonOutput</pre>
                                }
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="subcategory" class="form-label">Subcategoría *</label>
                                        <InputSelect id="subcategory" class="form-select" @bind-Value="createProductDto.SubcategoryId">
                                            <option value="">Seleccione una subcategoría</option>
                                            @if (subcategories?.Any() == true)
                                            {
                                                @foreach (var subcategory in subcategories)
                                                {
                                                    <option value="@subcategory.Id">@subcategory.Name</option>
                                                }
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => createProductDto.SubcategoryId)" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="price" class="form-label">Precio de Venta</label>
                                        <InputNumber id="price" class="form-control" @bind-Value="createProductDto.SalePrice" step="1.00" />
                                        <ValidationMessage For="@(() => createProductDto.SalePrice)" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <InputFile OnChange="HandleImageUpload" accept="image/*" />
                                        @if (previewUrl != null)
                                        {
                                            <img src="@previewUrl" style="max-width:300px; margin-top:10px;" />
                                        }
                                    </div>>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between">
                                <NavLink type="button" class="btn btn-secondary" href="/products">
                                    <i class="fas fa-arrow-left"></i> Vuelta a Artículos
                                </NavLink> 
                                <button type="submit" class="btn btn-primary" disabled="@submitting">
                                    @if (submitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="fas fa-save"></i> Crear Articulo
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private JsonNode Root = JsonNode.Parse(@"{
      ""Caracteristicas"": { ""Color"": ""Azul"", ""Tamaño"": ""Grande"" },
      ""EnStock"": ""Si"",
      ""Transportable"": ""Si"",
      ""Marca/Modelo"": [ ""Siam"", ""Queseyo"" ]
    }")!;

    private string JsonOutput = string.Empty;

    private void UpdateJson()
    {
        JsonOutput = Root.ToJsonString(new JsonSerializerOptions { WriteIndented = true });
        createProductDto.Characteristics = JsonOutput;
    }

    private void Save() => UpdateJson();
    
    private string? previewUrl;
    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // Resize image if needed
        var resizedImageFile = await file.RequestImageFileAsync(file.ContentType, 400, 400);

        using var stream = resizedImageFile.OpenReadStream(maxAllowedSize: 10_000_000); // limit 10 MB
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        var bytes = ms.ToArray();
        previewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
        createProductDto.Image = bytes;
    }

    private CreateProductDto createProductDto = new();
    private List<SubcategoryDto> subcategories = new();
    private bool loading = true;
    private bool submitting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubcategories();
    }

    private async Task LoadSubcategories()
    {
        var result = await ProductService.GetSubcategoriesAsync();
        if (result?.Success == true && result.Data != null)
        {
            subcategories = result.Data;
        }
        loading = false;
    }

    private async Task HandleValidSubmit()
    {
        submitting = true;
        var result = await ProductService.CreateAsync(createProductDto);

        if (result?.Success == true)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Product created successfully!");
            Navigation.NavigateTo("/products");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error creating product: {result?.Message}");
        }

        submitting = false;
    }
}