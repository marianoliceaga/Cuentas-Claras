@page "/collectors"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject ICollectorService CollectorService
@inject IJSRuntime JSRuntime

<PageTitle>Collectors Management</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="fas fa-users me-2"></i>Collectors Management
                </h2>
                <button type="button" class="btn btn-primary" @onclick="ShowCreateModal">
                    <i class="fas fa-plus me-2"></i>Add New Collector
                </button>
            </div>

            @if (isLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (collectors.Any())
            {
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Name</th>
                                        <th>Commission %</th>
                                        <th>Phone</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var collector in collectors)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@collector.Name</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@collector.CommisionPercentage%</span>
                                            </td>
                                            <td>@collector.Phone</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => ShowEditModal(collector)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => DeleteCollector(collector.Id)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i>
                    No collectors found. Click "Add New Collector" to create one.
                </div>
            }
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade @(showModal ? "show" : "")" style="display: @(showModal ? "block" : "none")" tabindex="-1">
    <div class="modal-backdrop fade @(showModal ? "show" : "")" @onclick="HideModal"></div>
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @if (isEditing)
                    {
                        <i class="fas fa-edit me-2"></i>
                        <span>Edit Collector</span>
                    }
                    else
                    {
                        <i class="fas fa-plus me-2"></i>
                        <span>Add New Collector </span>
                    }
                </h5>
                <button type="button" class="btn-close" @onclick="HideModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="currentCollector" OnValidSubmit="SaveCollector">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
                            <InputText id="name" class="form-control" @bind-Value="currentCollector.Name"
                                       placeholder="Enter collector name" />
                            <ValidationMessage For="@(() => currentCollector.Name)" class="text-danger" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="phone" class="form-label">Phone</label>
                            <InputText id="phone" class="form-control" @bind-Value="currentCollector.Phone"
                                       placeholder="Enter phone number" />
                            <ValidationMessage For="@(() => currentCollector.Phone)" class="text-danger" />
                        </div>
                        <div class="col-12 mb-3">
                            <label for="commission" class="form-label">Commission Percentage</label>
                            <InputNumber id="commission" class="form-control" @bind-Value="currentCollector.CommisionPercentage"
                                         min="0" max="100" />
                            <ValidationMessage For="@(() => currentCollector.CommisionPercentage)" class="text-danger" />
                            <div class="form-text">Enter percentage (0-100)</div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 px-0 pb-0">
                        <button type="button" class="btn btn-secondary" @onclick="HideModal">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="fas fa-save me-2"></i>
                            }
                            @(isEditing ? "Update" : "Save") Collector
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<CollectorDto> collectors = new();
    private CollectorDto currentCollector = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditing = false;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCollectors();
    }

    private async Task LoadCollectors()
    {
        try
        {
            isLoading = true;
            var result = await CollectorService.GetAllAsync();
            collectors = result.ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading collectors: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        currentCollector = new CollectorDto();
        isEditing = false;
        showModal = true;
    }

    private void ShowEditModal(CollectorDto collector)
    {
        currentCollector = new CollectorDto
        {
            Id = collector.Id,
            Name = collector.Name,
            CommisionPercentage = collector.CommisionPercentage,
            Phone = collector.Phone
        };
        isEditing = true;
        showModal = true;
    }

    private void HideModal()
    {
        showModal = false;
        currentCollector = new CollectorDto();
        isSaving = false;
    }

    private async Task SaveCollector()
    {
        try
        {
            isSaving = true;

            if (isEditing)
            {
                await CollectorService.UpdateAsync(currentCollector.Id, currentCollector);
                await JSRuntime.InvokeVoidAsync("alert", "Collector updated successfully!");
            }
            else
            {
                await CollectorService.CreateAsync(currentCollector);
                await JSRuntime.InvokeVoidAsync("alert", "Collector created successfully!");
            }

            HideModal();
            await LoadCollectors();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving collector: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCollector(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            "Are you sure you want to delete this collector? This action cannot be undone.");

        if (!confirmed) return;

        try
        {
            await CollectorService.DeleteAsync(id);
            await JSRuntime.InvokeVoidAsync("alert", "Collector deleted successfully!");
            await LoadCollectors();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error deleting collector: {ex.Message}");
        }
    }
}