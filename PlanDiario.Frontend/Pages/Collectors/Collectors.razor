@page "/collectors"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject ICollectorService CollectorService
@inject IJSRuntime JSRuntime

<PageTitle>Administración de Cobradores</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="fas fa-users me-2"></i>Administración de Cobradores
                </h2>
                <button type="button" class="btn btn-primary" @onclick="ShowCreateModal">
                    <i class="fas fa-plus me-2"></i>Agregar Nuevo Cobrador
                </button>
            </div>

            @if (isLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (collectors.Any())
            {
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Comisión %</th>
                                        <th>Teléfono</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var collector in collectors)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@collector.Name</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@collector.CommisionPercentage%</span>
                                            </td>
                                            <td>@collector.Phone</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => ShowEditModal(collector)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => DeleteCollector(collector.Id)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i>
                    No se encuentran cobradores. Clickea "Agregar Nuevo Cobrador" para crear uno.
                </div>
            }
        </div>
    </div>
</div>

@* Backdrop rendered only when the modal is open *@
@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
}

@* Modal container: clicking outside closes; clicks inside do NOT bubble *@
<div class="modal fade @(showModal ? "show d-block" : "")"
     tabindex="-1"
     role="dialog"
     aria-modal="@(showModal ? "true" : null)"
     style="@(showModal ? "display:block" : "display:none")"
     @onclick="HandleOutsideClick">
    <div class="modal-dialog modal-lg" role="document" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @if (isEditing)
                    {
                        <i class="fas fa-edit me-2"></i>
                        <span>Editar Cobrador</span>
                    }
                    else
                    {
                        <i class="fas fa-plus me-2"></i>
                        <span>Agregar Nuevo Cobrador</span>
                    }
                </h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="HideModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="currentCollector" OnValidSubmit="SaveCollector">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label">Nombre <span class="text-danger">*</span></label>
                            <InputText id="name" class="form-control" @bind-Value="currentCollector.Name"
                                       placeholder="Nombre del Cobrador" />
                            <ValidationMessage For="@(() => currentCollector.Name)" class="text-danger" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="phone" class="form-label">Telefono</label>
                            <InputText id="phone" class="form-control" @bind-Value="currentCollector.Phone"
                                       placeholder="Numero de Telefono" />
                            <ValidationMessage For="@(() => currentCollector.Phone)" class="text-danger" />
                        </div>
                        <div class="col-12 mb-3">
                            <label for="commission" class="form-label">Porcentaje de Comision</label>
                            <InputNumber id="commission" class="form-control" @bind-Value="currentCollector.CommisionPercentage"
                                         min="0" max="100" />
                            <ValidationMessage For="@(() => currentCollector.CommisionPercentage)" class="text-danger" />
                            <div class="form-text">Porcentaje (0-100)</div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 px-0 pb-0">
                        <button type="button" class="btn btn-secondary" @onclick="HideModal">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="fas fa-save me-2"></i>
                            }
                            @(isEditing ? "Actualizar" : "Guardar") Cobrador
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<CollectorDto> collectors = new();
    private CollectorDto currentCollector = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditing = false;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCollectors();
    }

    private async Task LoadCollectors()
    {
        try
        {
            isLoading = true;
            var result = await CollectorService.GetAllAsync();
            collectors = result.ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error cargando cobradores: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetBodyScrollLockAsync(bool locked)
    {
        // Locks background scroll like Bootstrap does when a modal is open
        var js = locked
            ? "document.body.classList.add('modal-open');"
            : "document.body.classList.remove('modal-open');";
        await JSRuntime.InvokeVoidAsync("eval", js);
    }

    private async Task ShowCreateModal()
    {
        currentCollector = new CollectorDto();
        isEditing = false;
        showModal = true;
        await SetBodyScrollLockAsync(true);
        StateHasChanged();
    }

    private async Task ShowEditModal(CollectorDto collector)
    {
        currentCollector = new CollectorDto
        {
            Id = collector.Id,
            Name = collector.Name,
            CommisionPercentage = collector.CommisionPercentage,
            Phone = collector.Phone
        };
        isEditing = true;
        showModal = true;
        await SetBodyScrollLockAsync(true);
        StateHasChanged();
    }

    private async Task HideModal()
    {
        showModal = false;
        currentCollector = new CollectorDto();
        isSaving = false;
        await SetBodyScrollLockAsync(false);
        StateHasChanged();
    }

    private async Task HandleOutsideClick()
    {
        // Clicking the shaded area outside the dialog closes the modal
        await HideModal();
    }

    private async Task SaveCollector()
    {
        try
        {
            isSaving = true;

            if (isEditing)
            {
                await CollectorService.UpdateAsync(currentCollector.Id, currentCollector);
                await JSRuntime.InvokeVoidAsync("alert", "Cobrador actualizado exitosamente!");
            }
            else
            {
                await CollectorService.CreateAsync(currentCollector);
                await JSRuntime.InvokeVoidAsync("alert", "Cobrador creado exitosamente!");
            }

            await HideModal();
            await LoadCollectors();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error guardando cobrador: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCollector(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            "Estas seguro que deseas borrar a este cobrador? Esta accion no puede ser deshecha.");

        if (!confirmed) return;

        try
        {
            await CollectorService.DeleteAsync(id);
            await JSRuntime.InvokeVoidAsync("alert", "Cobrador borrado exitosamente!");
            await LoadCollectors();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error borrando cobrador: {ex.Message}");
        }
    }
}
