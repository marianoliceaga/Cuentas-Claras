@page "/customers"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject ICustomerService CustomerService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Customers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Customers</h3>
    <button class="btn btn-primary" @onclick="NavigateToCreate">
        <i class="fas fa-plus"></i> New Customer
    </button>
</div>

@if (loading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (customers?.Any() == true)
{
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Search by name or DNI..."
                   @bind="searchTerm" @onkeyup="FilterCustomers" />
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>DNI</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Locality</th>
                    <th>Collector</th>
                    <th>Salesman</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in filteredCustomers)
                {
                    <tr>
                        <td>@customer.DNI</td>
                        <td>@($"{customer.Name} {customer.LastName}")</td>
                        <td>@customer.Phone1</td>
                        <td>@customer.Locality?.Name</td>
                        <td>@customer.Collector?.Name</td>
                        <td>@customer.Salesman?.Name</td>
                        <td>
                            <div class="btn-group" role="group">
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="() => NavigateToDetails(customer.Id)">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-warning"
                                        @onclick="() => NavigateToEdit(customer.Id)">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteCustomer(customer)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No customers found.
    </div>
}

@code {
    private IEnumerable<CustomerDto>? customers;
    private IEnumerable<CustomerDto> filteredCustomers = new List<CustomerDto>();
    private bool loading = true;
    private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        loading = true;
        customers = await CustomerService.GetAllCustomersAsync();
        filteredCustomers = customers ?? new List<CustomerDto>();
        loading = false;
    }

    private void FilterCustomers()
    {
        if (customers == null) return;

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredCustomers = customers;
        }
        else
        {
            filteredCustomers = customers.Where(c =>
                c.DNI.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                c.LastName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            );
        }
    }

    private void NavigateToCreate() => Navigation.NavigateTo("/customers/create");
    private void NavigateToEdit(Guid id) => Navigation.NavigateTo($"/customers/edit/{id}");
    private void NavigateToDetails(Guid id) => Navigation.NavigateTo($"/customers/{id}");

    private async Task DeleteCustomer(CustomerDto customer)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete {customer.Name} {customer.LastName}?");

        if (confirmed)
        {
            var success = await CustomerService.DeleteCustomerAsync(customer.Id);
            if (success)
            {
                await LoadCustomers();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Failed to delete customer.");
            }
        }
    }
}
