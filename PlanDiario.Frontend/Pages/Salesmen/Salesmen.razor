@page "/salesmen"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject ISalesmanService SalesmanService
@inject IJSRuntime JSRuntime

<PageTitle>Administracion de Vendedores</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="fas fa-handshake me-2"></i>Administracion de Vendedores
                </h2>
                <button type="button" class="btn btn-primary" @onclick="ShowCreateModal">
                    <i class="fas fa-plus me-2"></i>Agregar nuevo vendedor
                </button>
            </div>

            @if (isLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (salesmen.Any())
            {
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Commision %</th>
                                        <th>Telefono</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var salesman in salesmen)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@salesman.Name</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-success">@salesman.CommissionPercentage%</span>
                                            </td>
                                            <td>@salesman.Phone</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => ShowEditModal(salesman)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => DeleteSalesman(salesman.Id)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i>
                    No se encontraron vendedores. Clickea "Agregar Nuevo Vendedor" para crear uno.
                </div>
            }
        </div>
    </div>
</div>

@* Backdrop rendered only when the modal is open *@
@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
}

@* Modal container: clicking outside closes; clicks inside do NOT bubble *@
<div class="modal fade @(showModal ? "show d-block" : "")"
     tabindex="-1"
     role="dialog"
     aria-modal="@(showModal ? "true" : null)"
     style="@(showModal ? "display:block" : "display:none")"
     @onclick="HandleOutsideClick">
    <div class="modal-dialog modal-lg" role="document" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @if (isEditing)
                    {
                        <i class="fas fa-edit me-2"></i>
                        <span>Editar Vendedor</span>
                    }
                    else
                    {
                        <i class="fas fa-plus me-2"></i>
                        <span>Agregar Nuevo Vendedor</span>
                    }
                </h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="HideModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="currentSalesman" OnValidSubmit="SaveSalesman">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label">Nombre <span class="text-danger">*</span></label>
                            <InputText id="name" class="form-control" @bind-Value="currentSalesman.Name"
                                       placeholder="Nombre del Vendedor" />
                            <ValidationMessage For="@(() => currentSalesman.Name)" class="text-danger" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="phone" class="form-label">Telefono</label>
                            <InputText id="phone" class="form-control" @bind-Value="currentSalesman.Phone"
                                       placeholder="Numero de telefono" />
                            <ValidationMessage For="@(() => currentSalesman.Phone)" class="text-danger" />
                        </div>
                        <div class="col-12 mb-3">
                            <label for="commission" class="form-label">Porcentaje de Comision</label>
                            <InputNumber id="commission" class="form-control" @bind-Value="currentSalesman.CommissionPercentage"
                                         min="0" max="100" />
                            <ValidationMessage For="@(() => currentSalesman.CommissionPercentage)" class="text-danger" />
                            <div class="form-text">Porcentaje (0-100)</div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 px-0 pb-0">
                        <button type="button" class="btn btn-secondary" @onclick="HideModal">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="fas fa-save me-2"></i>
                            }
                            @(isEditing ? "Update" : "Save") Vendedor
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<SalesmanDto> salesmen = new();
    private SalesmanDto currentSalesman = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditing = false;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSalesmen();
    }

    private async Task LoadSalesmen()
    {
        try
        {
            isLoading = true;
            var result = await SalesmanService.GetAllAsync();
            salesmen = result.ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error guardando vendedor: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetBodyScrollLockAsync(bool locked)
    {
        var js = locked
            ? "document.body.classList.add('modal-open');"
            : "document.body.classList.remove('modal-open');";
        await JSRuntime.InvokeVoidAsync("eval", js);
    }

    private async Task ShowCreateModal()
    {
        currentSalesman = new SalesmanDto();
        isEditing = false;
        showModal = true;
        await SetBodyScrollLockAsync(true);
        StateHasChanged();
    }

    private async Task ShowEditModal(SalesmanDto salesman)
    {
        currentSalesman = new SalesmanDto
        {
            Id = salesman.Id,
            Name = salesman.Name,
            CommissionPercentage = salesman.CommissionPercentage,
            Phone = salesman.Phone
        };
        isEditing = true;
        showModal = true;
        await SetBodyScrollLockAsync(true);
        StateHasChanged();
    }

    private async Task HideModal()
    {
        showModal = false;
        currentSalesman = new SalesmanDto();
        isSaving = false;
        await SetBodyScrollLockAsync(false);
        StateHasChanged();
    }

    private async Task HandleOutsideClick()
    {
        // Clicking the shaded area outside the dialog closes the modal
        await HideModal();
    }

    private async Task SaveSalesman()
    {
        try
        {
            isSaving = true;

            if (isEditing)
            {
                await SalesmanService.UpdateAsync(currentSalesman.Id, currentSalesman);
                await JSRuntime.InvokeVoidAsync("alert", "Vendedor actualizado exitosamente!");
            }
            else
            {
                await SalesmanService.CreateAsync(currentSalesman);
                await JSRuntime.InvokeVoidAsync("alert", "Vendedor creado exitosamente!");
            }

            await HideModal();
            await LoadSalesmen();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error guardando vendedor: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteSalesman(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            "Estas seguro de que queres borrar a este vendedor? Esta accion no puede ser deshecha.");

        if (!confirmed) return;

        try
        {
            await SalesmanService.DeleteAsync(id);
            await JSRuntime.InvokeVoidAsync("alert", "Vendedor borrado exitosamente!");
            await LoadSalesmen();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error borrando vendedor: {ex.Message}");
        }
    }
}
