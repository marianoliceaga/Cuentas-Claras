@page "/plans/{id:int}"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject IPlanService PlanService
@inject IProductPlanService ProductPlanService
@inject NavigationManager Navigation

<PageTitle>Detalles del Plan</PageTitle>

<div class="container">
    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (plan != null)
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3>Detalles del Plan</h3>
                        <div>
                            <NavLink class="btn btn-warning me-2" href="@($"/plans/edit/{plan.Id}")">
                                <i class="fas fa-edit"></i> Editar
                            </NavLink>

                            <NavLink class="btn btn-success" href="@($"/plans/{plan.Id}/products")">
                                <i class="fas fa-box"></i> Administrar Artículos
                            </NavLink>
S                       </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <strong>ID:</strong> @plan.Id
                            </div>
                            <div class="col-md-6">
                                <strong>Fecha de Creación:</strong> @plan.CreatedAt.ToString("dd/MM/yyyy")
                            </div>
                            <div class="col-md-6">
                                <strong>Fecha de Finalización:</strong> @plan.EndDate.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                        <hr />
                        <div class="mb-3">
                            <strong>Nombre:</strong>
                            <p>@plan.Name</p>
                        </div>
                        <hr />
                        <div class="mb-3">
                            <strong>Tasa de Interés:</strong>
                            <p>@plan.InterestRate</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5>Articulos Asociados</h5>
                    </div>
                    <div class="card-body">
                        @if (productPlans?.Any() == true)
                        {
                            <div class="list-group">
                                @foreach (var productPlan in productPlans)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1">@productPlan.ProductName</h6>
                                             @* <small>Qty: @productPlan.</small> *@
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Sin artículos asignados a este plan.</p>
                        }

                        <div class="mt-3">
                            <div class="col-auto">
                                <NavLink class="btn btn-primary btn-sm w-100" href="@($"/plans/{plan.Id}/products")">
                                    <i class="fas fa-plus"></i>  Agregar Articulos
                                </NavLink>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <NavLink class="btn btn-secondary" href="/plans">
                <i class="fas fa-arrow-left"></i> Vuelta a Planes
            </NavLink>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i> Plan no encontrado.
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private PlanDto? plan;
    private List<ProductPlanDto> productPlans = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlan();
        await LoadProductPlans();
    }

    private async Task LoadPlan()
    {
        var result = await PlanService.GetByIdAsync(Id);
        if (result?.Success == true)
        {
            plan = result.Data;
        }
    }

    private async Task LoadProductPlans()
    {
        var result = await ProductPlanService.GetByPlanIdAsync(Id);
        if (result?.Success == true && result.Data != null)
        {
            productPlans = result.Data;
        }
        loading = false;
    }
}
