@page "/plans/create"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject IPlanService PlanService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Crear Plan</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header">
                    <h3>Crear Plan</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="createPlanDto" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger" />

                        <div class="mb-3">
                            <label for="name" class="form-label">Nombre *</label>
                            <InputText id="name" class="form-control" @bind-Value="createPlanDto.Name" />
                            <ValidationMessage For="@(() => createPlanDto.Name)" />
                        </div>

                        <div class="mb-3">
                            <label for="createDate" class="form-label">Fecha de Creación *</label>
                            <InputDate id="createDate" class="form-control" @bind-Value="createPlanDto.StartDate" />
                            <ValidationMessage For="@(() => createPlanDto.StartDate)" />
                        </div>

                        <div class="mb-3">
                            <label for="createDate" class="form-label">Fecha de Finalización *</label>
                            <InputDate id="endDate" class="form-control" @bind-Value="createPlanDto.EndDate" />
                            <ValidationMessage For="@(() => createPlanDto.EndDate)" />
                        </div>

                        <div class="mb-3">
                            <label for="name" class="form-label">Tasa de Interés *</label>
                            <InputNumber id="name" class="form-control" @bind-Value="createPlanDto.InterestRate" />
                            <ValidationMessage For="@(() => createPlanDto.InterestRate)" />
                        </div>
                        

                        <div class="d-flex justify-content-between">
                            <NavLink class="btn btn-secondary" href="/plans/">
                                <i class="fas fa-arrow-left"></i> Vuelta a Planes
                            </NavLink>

                            <button type="submit" class="btn btn-primary" disabled="@loading">
                                @if (loading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-save"></i> Crear Plan
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreatePlanDto createPlanDto = new();
    private bool loading = false;

    protected override void OnInitialized()
    {
        if (createPlanDto.StartDate == DateTime.MinValue)
        {
            createPlanDto.StartDate = DateTime.UtcNow;
        }

        if(createPlanDto.EndDate == DateTime.MinValue)
        {
            createPlanDto.EndDate = DateTime.UtcNow.AddYears(1);
        }
    }

    private async Task HandleValidSubmit()
    {
        loading = true;
        var result = await PlanService.CreateAsync(createPlanDto);

        if (result?.Success == true)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Plan creado exitosamente!");
            Navigation.NavigateTo("/plans");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error creando plan: {result?.Message}");
        }

        loading = false;
    }
}