@page "/plans"

@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject IPlanService PlanService
@inject IProductPlanService ProductPlanService
@inject IProductService ProductService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Administración de Planes</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1>Administración de Planes</h1>
        </div>
        <div class="col-auto">
            <NavLink class="btn btn-primary" href="/plans/create">
                <i class="fas fa-plus"></i> Crear Nuevo Plan
            </NavLink>
    </div>

    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Buscar planes..." @bind="searchTerm" @onkeypress="OnSearchKeyPress" />
                <button class="btn btn-outline-primary" type="button" @onclick="SearchPlans">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (plans?.Any() == true)
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Fecha de Creación</th>
                                <th>Tasa de Finalización</th>
                                <th>Tasa de Interés</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plan in plans)
                            {
                                <tr>
                                    <td>@plan.Id</td>
                                    <td>@plan.Name</td>
                                    <td>@plan.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@plan.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>@plan.InterestRate</td>
                                    <td>
                                        <div class="btn-group" role="group">

                                            <NavLink class="btn btn-sm btn-info" href="@($"/plans/{plan.Id}")">
                                                <i class="fas fa-eye"></i> Ver
                                            </NavLink>
                                            <NavLink class="btn btn-sm btn-warning" href="@($"/plans/edit/{plan.Id}")">
                                                <i class="fas fa-edit"></i> Editar
                                            </NavLink>
                                            <button class="btn btn-sm btn-danger" @onclick="() => DeletePlan(plan.Id)">
                                                <i class="fas fa-trash"></i> Borrar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Pagination *@
                @if (totalPages > 1)
                {
                    <nav aria-label="Paginacion">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => LoadPage(currentPage - 1)" disabled="@(currentPage == 1)">Previa</button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                int pagination = i;
                                <li class="page-item @(currentPage == pagination ? "active" : "")">
                                    <button class="page-link" @onclick="() => LoadPage(pagination)">@pagination</button>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => LoadPage(currentPage + 1)" disabled="@(currentPage == totalPages)">Proxima</button>
                            </li>
                        </ul>
                    </nav>
                }

                @* Summary *@
                <div class="row mt-3">
                    <div class="col-md-6">
                        <strong>Items Totales: @productPlans.Sum(pp => pp.Quantity)</strong>
                    </div>
                    <div class="col-md-6 text-end">
                        <strong>Valor Total: $@productPlans.Sum(pp => (pp.ProductPrice != 0 ? pp.ProductPrice : 0) * pp.Quantity).ToString("F2")</strong>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No se encontraron articulos/planes.
        </div>
    }
</div>

@code {
    private List<ProductPlanDto> productPlans = new();
    private List<PlanDto> plans = new();
    private List<ProductDto> products = new();
    private bool loading = true;
    private string selectedPlanId = "";
    private string selectedProductId = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlans();
        await LoadProducts();
        await LoadProductPlans();
    }

    private async Task LoadPlans()
    {
        var result = await PlanService.GetAllAsync(1, 1000); // Get all plans
        if (result?.Success == true && result.Data != null)
        {
            plans = result.Data.Items;
        }
    }

    private async Task LoadProducts()
    {
        var result = await ProductService.GetAllAsync(1, 1000); // Get all products
        if (result?.Success == true && result.Data != null)
        {
            products = result.Data.Items;
        }
    }

    private async Task LoadProductPlans()
    {
        loading = true;
        int? planId = string.IsNullOrEmpty(selectedPlanId) ? null : int.Parse(selectedPlanId);
        int? productId = string.IsNullOrEmpty(selectedProductId) ? null : int.Parse(selectedProductId);

        var result = await ProductPlanService.GetAllAsync(currentPage, pageSize, planId, productId);

        if (result?.Success == true && result.Data != null)
        {
            productPlans = result.Data.Items;
            totalPages = result.Data.TotalPages;
        }
        else
        {
            productPlans = new List<ProductPlanDto>();
        }

        loading = false;
    }

    private async Task LoadPage(int page)
    {
        if (page < 1 || page > totalPages)
        {
            return;
        }

        currentPage = page;
        await LoadProductPlans();
    }

    private async Task OnPlanFilterChange(ChangeEventArgs e)
    {
        selectedPlanId = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadProductPlans();
    }

    private async Task OnProductFilterChange(ChangeEventArgs e)
    {
        selectedProductId = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadProductPlans();
    }

    private async Task DeletePlan(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Estás seguro que querés borrar a este plan?"))
        {
            var result = await PlanService.DeleteAsync(id);
            if (result?.Success == true)
            {
                await LoadPlans();
                await JSRuntime.InvokeVoidAsync("alert", "Plan borrado exitosamente!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error borrando plan: {result?.Message}");
            }
        }
    }

    private void OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SearchPlans();
        }
    }

    private void SearchPlans()
    {
        plans = plans.Where(p => p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
    }
}