@page "/salesmen"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject ISalesmanService SalesmanService
@inject IJSRuntime JSRuntime

<PageTitle>Salesmen Management</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="fas fa-handshake me-2"></i>Salesmen Management
                </h2>
                <button type="button" class="btn btn-primary" @onclick="ShowCreateModal">
                    <i class="fas fa-plus me-2"></i>Add New Salesman
                </button>
            </div>

            @if (isLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (salesmen.Any())
            {
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Name</th>
                                        <th>Commission %</th>
                                        <th>Phone</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var salesman in salesmen)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@salesman.Name</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-success">@salesman.CommissionPercentage%</span>
                                            </td>
                                            <td>@salesman.Phone</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => ShowEditModal(salesman)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => DeleteSalesman(salesman.Id)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i>
                    No salesmen found. Click "Add New Salesman" to create one.
                </div>
            }
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade @(showModal ? "show" : "")" style="display: @(showModal ? "block" : "none")" tabindex="-1">
    <div class="modal-backdrop fade @(showModal ? "show" : "")" @onclick="HideModal"></div>
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    @if (isEditing)
                    {
                        <i class="fas fa-edit me-2"></i>
                        <span>Edit Salesman</span>
                    }
                    else
                    {
                        <i class="fas fa-plus me-2"></i>
                        <span>Add New Salesman</span>
                    }
                </h5>
                <button type="button" class="btn-close" @onclick="HideModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="currentSalesman" OnValidSubmit="SaveSalesman">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
                            <InputText id="name" class="form-control" @bind-Value="currentSalesman.Name"
                                       placeholder="Enter salesman name" />
                            <ValidationMessage For="@(() => currentSalesman.Name)" class="text-danger" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="phone" class="form-label">Phone</label>
                            <InputText id="phone" class="form-control" @bind-Value="currentSalesman.Phone"
                                       placeholder="Enter phone number" />
                            <ValidationMessage For="@(() => currentSalesman.Phone)" class="text-danger" />
                        </div>
                        <div class="col-12 mb-3">
                            <label for="commission" class="form-label">Commission Percentage</label>
                            <InputNumber id="commission" class="form-control" @bind-Value="currentSalesman.CommissionPercentage"
                                         min="0" max="100" />
                            <ValidationMessage For="@(() => currentSalesman.CommissionPercentage)" class="text-danger" />
                            <div class="form-text">Enter percentage (0-100)</div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 px-0 pb-0">
                        <button type="button" class="btn btn-secondary" @onclick="HideModal">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="fas fa-save me-2"></i>
                            }
                            @(isEditing ? "Update" : "Save") Salesman
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<SalesmanDto> salesmen = new();
    private SalesmanDto currentSalesman = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditing = false;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSalesmen();
    }

    private async Task LoadSalesmen()
    {
        try
        {
            isLoading = true;
            var result = await SalesmanService.GetAllAsync();
            salesmen = result.ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading salesmen: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        currentSalesman = new SalesmanDto();
        isEditing = false;
        showModal = true;
    }

    private void ShowEditModal(SalesmanDto salesman)
    {
        currentSalesman = new SalesmanDto
        {
            Id = salesman.Id,
            Name = salesman.Name,
            CommissionPercentage = salesman.CommissionPercentage,
            Phone = salesman.Phone
        };
        isEditing = true;
        showModal = true;
    }

    private void HideModal()
    {
        showModal = false;
        currentSalesman = new SalesmanDto();
        isSaving = false;
    }

    private async Task SaveSalesman()
    {
        try
        {
            isSaving = true;

            if (isEditing)
            {
                await SalesmanService.UpdateAsync(currentSalesman.Id, currentSalesman);
                await JSRuntime.InvokeVoidAsync("alert", "Salesman updated successfully!");
            }
            else
            {
                await SalesmanService.CreateAsync(currentSalesman);
                await JSRuntime.InvokeVoidAsync("alert", "Salesman created successfully!");
            }

            HideModal();
            await LoadSalesmen();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving salesman: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteSalesman(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            "Are you sure you want to delete this salesman? This action cannot be undone.");

        if (!confirmed) return;

        try
        {
            await SalesmanService.DeleteAsync(id);
            await JSRuntime.InvokeVoidAsync("alert", "Salesman deleted successfully!");
            await LoadSalesmen();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error deleting salesman: {ex.Message}");
        }
    }
}