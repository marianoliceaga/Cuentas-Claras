@page "/productplans"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject IProductPlanService ProductPlanService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Artículos/Planes</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Artículos/Planes</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-primary" @onclick="CreateNew">
                            <i class="fas fa-plus"></i> Crear Nueva relación Artículo/Planes
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filters -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="planIdFilter" class="form-label">Filtrar por Plan ID:</label>
                                <input type="number" id="planIdFilter" class="form-control" @bind="planIdFilter" @bind:event="oninput" @onchange="ApplyFilters" placeholder="Ingrese Plan ID" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="productIdFilter" class="form-label">Filter by Product ID:</label>
                                <input type="number" id="productIdFilter" class="form-control" @bind="productIdFilter" @bind:event="oninput" @onchange="ApplyFilters" placeholder="Ingrese Artículo ID" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="pageSizeSelect" class="form-label">Items por página:</label>
                                <select id="pageSizeSelect" class="form-select" @bind="pageSize" @bind:event="onchange">
                                    <option value="5">5</option>
                                    <option value="10">10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">&nbsp;</label>
                                <div class="d-grid gap-2">
                                    <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">
                                        <i class="fas fa-times me-1"></i> Limpiar Filtros
                                    </button>
                                    <button type="button" class="btn btn-outline-primary" @onclick="RefreshData">
                                        <i class="fas fa-sync-alt me-1"></i> Refrescar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (isLoading)
                    {
                        <div class="d-flex justify-content-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @errorMessage
                        </div>
                    }
                    else
                    {
                        @if (pagedResult?.Items?.Any() == true)
                        {
                            <!-- Data Table -->
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>ID</th>
                                            <th>Artículo ID</th>
                                            <th>Plan ID</th>
                                            <th>Nombre de Artículo</th>
                                            <th>Nombre del Plan</th>
                                            <th>Catergoría</th>
                                            <th width="200">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in pagedResult.Items)
                                        {
                                            <tr>
                                                <td>@item.Id</td>
                                                <td>@item.ProductId</td>
                                                <td>@item.PlanId</td>
                                                <td>@(string.IsNullOrEmpty(item.ProductName) ? "-" : item.ProductName)</td>
                                                <td>@(string.IsNullOrEmpty(item.PlanName) ? "-" : item.PlanName)</td>
                                                <td>@(string.IsNullOrEmpty(item.CategoryName) ? "-" : item.CategoryName)</td>
                                                <td>
                                                    <div class="btn-group" role="group">
                                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetails(item.Id)" title="Ver Detalles">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => EditItem(item.Id)" title="Editar">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(item.Id)" title="Borrar">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination Info -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="dataTables_info">
                                        Mostrando @((pagedResult.PageNumber - 1) * pagedResult.PageSize + 1) hasta @Math.Min(currentPage * pagedResult.PageSize, pagedResult.TotalCount) de @pagedResult.TotalCount registros
                                        @if (hasActiveFilters)
                                        {
                                            <span class="text-muted">(filtered)</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <!-- Pagination Controls -->
                                    @if (pagedResult.TotalPages > 1)
                                    {
                                        <nav aria-label="Paginado">
                                            <ul class="pagination justify-content-end">
                                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                                    <button class="page-link" @onclick="() => GoToPage(1)" disabled="@(currentPage <= 1)">
                                                        <i class="fas fa-angle-double-left"></i>
                                                    </button>
                                                </li>
                                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage <= 1)">
                                                        <i class="fas fa-angle-left"></i>
                                                    </button>
                                                </li>

                                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(pagedResult.TotalPages, currentPage + 2); i++)
                                                {
                                                    var pageNumber = i;
                                                    <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                                        <button class="page-link" @onclick="() => GoToPage(pageNumber)">
                                                            @pageNumber
                                                        </button>
                                                    </li>
                                                }

                                                <li class="page-item @(currentPage >= pagedResult.TotalPages ? "disabled" : "")">
                                                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage >= pagedResult.TotalPages)">
                                                        <i class="fas fa-angle-right"></i>
                                                    </button>
                                                </li>
                                                <li class="page-item @(currentPage >= pagedResult.TotalPages ? "disabled" : "")">
                                                    <button class="page-link" @onclick="() => GoToPage(pagedResult.TotalPages)" disabled="@(currentPage >= pagedResult.TotalPages)">
                                                        <i class="fas fa-angle-double-right"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </nav>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <div class="mb-3">
                                    <i class="fas fa-box-open fa-3x text-muted"></i>
                                </div>
                                <h5 class="text-muted">No se encuentran relaciones Artículos/Planes</h5>
                                <p class="text-muted">
                                    @if (hasActiveFilters)
                                    {
                                        <span>No hay relaciones para tus filtros actuales.</span>
                                        <br />
                                        <button type="button" class="btn btn-outline-secondary mt-2" @onclick="ClearFilters">
                                            <i class="fas fa-times me-1"></i> Limpiar Filtros
                                        </button>
                                    }
                                    else
                                    {
                                        <span>No hay Artículos/Planes guardados</span>
                                        <br />
                                        <button type="button" class="btn btn-primary mt-2" @onclick="CreateNew">
                                            <i class="fas fa-plus me-1"></i> Crear la primera relación Artículos/Planes
                                        </button>
                                    }
                                </p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private PagedResult<ProductPlanDto>? pagedResult;
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    // Pagination and filtering
    private int currentPage = 1;
    private int pageSize = 10;
    private int? planIdFilter;
    private int? productIdFilter;

    private bool hasActiveFilters => planIdFilter.HasValue || productIdFilter.HasValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            var response = await ProductPlanService.GetAllAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                planId: planIdFilter,
                productId: productIdFilter
            );

            if (response?.Success == true && response.Data != null)
            {
                pagedResult = response.Data;
            }
            else
            {
                errorMessage = response?.Message ?? "Ocurrio un error cargando las relaciones.";
                pagedResult = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error desconocido {ex.Message}";
            pagedResult = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GoToPage(int page)
    {
        if (page != currentPage && page > 0 && (pagedResult == null || page <= pagedResult.TotalPages))
        {
            currentPage = page;
            await LoadData();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newPageSize) && newPageSize != pageSize)
        {
            pageSize = newPageSize;
            currentPage = 1; // Reset to first page when changing page size
            await LoadData();
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1; // Reset to first page when applying filters
        await LoadData();
    }

    private async Task ClearFilters()
    {
        planIdFilter = null;
        productIdFilter = null;
        currentPage = 1;
        await LoadData();
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private void CreateNew()
    {
        Navigation.NavigateTo("/productplans/create");
    }

    private void ViewDetails(int id)
    {
        Navigation.NavigateTo($"/productplans/details/{id}");
    }

    private void EditItem(int id)
    {
        Navigation.NavigateTo($"/productplans/edit/{id}");
    }

    private async Task ConfirmDelete(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Estás seguro que deseas borrar esta relación");
        if (confirmed)
        {
            await DeleteItem(id);
        }
    }

    private async Task DeleteItem(int id)
    {
        try
        {
            var response = await ProductPlanService.DeleteAsync(id);

            if (response?.Success == true)
            {
                await JSRuntime.InvokeVoidAsync("alert", "success", "La relación fue borrada exitosamente!");
                
                // If we're on a page that would be empty after deletion, go to previous page
                if (pagedResult != null && pagedResult.Items.Count == 1 && currentPage > 1)
                {
                    currentPage--;
                }
                
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "error", response?.Message ?? "Ocurrió un error.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "error", $"Ocurrió un error: {ex.Message}");
        }
    }
}