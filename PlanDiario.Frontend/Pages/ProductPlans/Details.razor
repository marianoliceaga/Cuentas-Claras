@page "/productplans/{id:int}"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject IProductPlanService ProductPlanService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IPlanService PlanService

<PageTitle>Product Plan Details</PageTitle>

<div class="container">
    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (plans != null && plans.Any())
    {
        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3>Product Plan Details</h3>
                        <div>
                        </div>
                    </div>

                    @* Pagination *@
                    @if (totalPages > 1)
                    {
                        <nav aria-label="Plans pagination">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => LoadPage(currentPage - 1)" disabled="@(currentPage == 1)">Previous</button>
                                </li>
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    int pagination = i;
                                    <li class="page-item @(currentPage == pagination ? "active" : "")">
                                        <button class="page-link" @onclick="() => LoadPage(pagination)">@pagination</button>
                                    </li>
                                }
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => LoadPage(currentPage + 1)" disabled="@(currentPage == totalPages)">Next</button>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No plans found.
        </div>
    }
</div>

@code {
    private List<PlanDto> plans = new();
    private bool loading = true;
    private string searchTerm = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadPlans();
    }

    private async Task LoadPlans()
    {
        loading = true;
        var result = await PlanService.GetAllAsync(currentPage, pageSize, searchTerm);

        if (result?.Success == true && result.Data != null)
        {
            plans = result.Data.Items;
            totalPages = result.Data.TotalPages;
        }
        else
        {
            plans = new List<PlanDto>();
        }

        loading = false;
    }

    private async Task LoadPage(int page)
    {
        currentPage = page;
        await LoadPlans();
    }

    private async Task SearchPlans()
    {
        currentPage = 1;
        await LoadPlans();
    }

    private async Task OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchPlans();
        }
    }

    private async Task DeletePlan(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this plan?"))
        {
            var result = await PlanService.DeleteAsync(id);
            if (result?.Success == true)
            {
                await LoadPlans();
                await JSRuntime.InvokeVoidAsync("alert", "Plan deleted successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error deleting plan: {result?.Message}");
            }
        }
    }
}
