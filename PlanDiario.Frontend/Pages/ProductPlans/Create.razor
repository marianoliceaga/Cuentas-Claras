@page "/productplans/create"
@using PlanDiario.Application.DTOs
@using PlanDiario.Frontend.Services
@inject IProductPlanService ProductPlanService
@inject IProductService ProductService
@inject IPlanService PlanService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Crear Nuevo Artículo/Plan</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Crear Nuevo Artículo/Plan</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-secondary" @onclick="GoBack">
                            <i class="fas fa-arrow-left"></i> Volver a la lista
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }

                    @if (isLoadingData)
                    {
                        <div class="d-flex justify-content-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@model" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label for="productId" class="form-label">Artículo <span class="text-danger">*</span></label>
                                        <InputSelect id="productId" class="form-select" @bind-Value="model.ProductId">
                                            <option value="0">-- Seleccionar Artículo --</option>
                                            @if (products != null)
                                            {
                                                @foreach (var product in products)
                                                {
                                                    <option value="@product.Id">@product.Name</option>
                                                }
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => model.ProductId)" class="text-danger" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label for="planId" class="form-label">Plan <span class="text-danger">*</span></label>
                                        <InputSelect id="planId" class="form-select" @bind-Value="model.PlanId">
                                            <option value="0">-- Seleccionar Plan --</option>
                                            @if (plans != null)
                                            {
                                                @foreach (var plan in plans)
                                                {
                                                    <option value="@plan.Id">@plan.Name</option>
                                                }
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="@(() => model.PlanId)" class="text-danger" />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12">
                                    <div class="form-group d-flex gap-2">
                                        <button type="submit" class="btn btn-primary" disabled="@(isLoading || isLoadingData)">
                                            @if (isLoading)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                            }
                                            <i class="fas fa-save me-1"></i> Crear Artículo/Plan
                                        </button>
                                        <button type="button" class="btn btn-secondary" @onclick="ResetForm" disabled="@(isLoading || isLoadingData)">
                                            <i class="fas fa-undo me-1"></i> Resetear
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" @onclick="GoBack" disabled="@(isLoading || isLoadingData)">
                                            <i class="fas fa-times me-1"></i> Cancelar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateProductPlanDto model = new();
    private bool isLoading = false;
    private bool isLoadingData = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private List<ProductDto>? products;
    private List<PlanDto>? plans;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            StateHasChanged();

            // Load products and plans concurrently
            var productTask = ProductService.GetAllAsync();
            var planTask = PlanService.GetAllAsync();

            await Task.WhenAll(productTask, planTask);

            var productResponse = await productTask;
            var planResponse = await planTask;

            if (productResponse?.Success == true)
            {
                products = productResponse.Data!.Items ?? new List<ProductDto>();
            }
            else
            {
                products = new List<ProductDto>();
                errorMessage = "Error al cargar los artículos.";
            }

            if (planResponse?.Success == true)
            {
                plans = planResponse.Data.Items ?? new List<PlanDto>();
            }
            else
            {
                plans = new List<PlanDto>();
                if (string.IsNullOrEmpty(errorMessage))
                    errorMessage = "Error al cargar los planes.";
                else
                    errorMessage += " Error al cargar los planes.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar los datos: {ex.Message}";
            products = new List<ProductDto>();
            plans = new List<PlanDto>();
        }
        finally
        {
            isLoadingData = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;
            StateHasChanged();

            // Validate selections
            if (model.ProductId <= 0)
            {
                errorMessage = "Debe seleccionar un artículo.";
                return;
            }

            if (model.PlanId <= 0)
            {
                errorMessage = "Debe seleccionar un plan.";
                return;
            }

            // Check if the product plan already exists
            var existsResponse = await ProductPlanService.CheckExistsAsync(model.PlanId, model.ProductId);
            if (existsResponse?.Success == true && existsResponse.Data == true)
            {
                errorMessage = "Ya existe una combinación de este Artículo y Plan.";
                return;
            }

            var response = await ProductPlanService.CreateAsync(model);

            if (response?.Success == true)
            {
                successMessage = "Artículo/Plan creado exitosamente";
                await JSRuntime.InvokeVoidAsync("alert", "success", "Artículo/Plan creado exitosamente!");

                // Wait a moment to show the success message, then navigate
                await Task.Delay(1500);
                Navigation.NavigateTo("/productplans");
            }
            else
            {
                errorMessage = response?.Message ?? "Ocurrió un error creando el Artículo/Plan.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleInvalidSubmit()
    {
        errorMessage = "Corrija los errores de validación.";
        await Task.CompletedTask;
    }

    private async Task ResetForm()
    {
        model = new CreateProductPlanDto();
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/productplans");
    }
}