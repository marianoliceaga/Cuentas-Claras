@page "/productplans/edit/{id:int}"
@using CuentasClaras.Application.DTOs
@using CuentasClaras.Frontend.Services
@inject IProductPlanService ProductPlanService
@inject IProductService ProductService
@inject IPlanService PlanService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Editar Artículo/Plan</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Editar Artículo/Plan</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-secondary me-2" @onclick="GoBack">
                            <i class="fas fa-arrow-left"></i> De vuelta a la lista
                        </button>
                        @if (originalProductPlan != null)
                        {
                            <button type="button" class="btn btn-outline-primary" @onclick="() => ViewDetails(originalProductPlan.Id)">
                                <i class="fas fa-eye"></i> Ver Detalles
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (isLoadingInitial)
                    {
                        <div class="d-flex justify-content-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }
                    else if (originalProductPlan == null)
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No se encontró
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @successMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-8">
                                <EditForm Model="@model" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary class="text-danger" />

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label for="productId" class="form-label">Artículo <span class="text-danger">*</span></label>
                                                <InputSelect id="productId" class="form-select" @bind-Value="model.ProductId">
                                                    <option value="0">-- Seleccionar Artículo --</option>
                                                    @if (products != null)
                                                    {
                                                        @foreach (var product in products)
                                                        {
                                                            <option value="@product.Id">@product.Name</option>
                                                        }
                                                    }
                                                </InputSelect>
                                                <ValidationMessage For="@(() => model.ProductId)" class="text-danger" />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label for="planId" class="form-label">Plan <span class="text-danger">*</span></label>
                                                <InputSelect id="planId" class="form-select" @bind-Value="model.PlanId">
                                                    <option value="0">-- Seleccionar Plan --</option>
                                                    @if (plans != null)
                                                    {
                                                        @foreach (var plan in plans)
                                                        {
                                                            <option value="@plan.Id">@plan.Name</option>
                                                        }
                                                    }
                                                </InputSelect>
                                                <ValidationMessage For="@(() => model.PlanId)" class="text-danger" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-12">
                                            <div class="form-group d-flex gap-2">
                                                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                                    @if (isLoading)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                                    }
                                                    <i class="fas fa-save me-1"></i> Actualizar
                                                </button>
                                                <button type="button" class="btn btn-secondary" @onclick="ResetForm" disabled="@isLoading">
                                                    <i class="fas fa-undo me-1"></i> Resetear
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary" @onclick="GoBack" disabled="@isLoading">
                                                    <i class="fas fa-times me-1"></i> Cancelar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </EditForm>
                            </div>

                            <div class="col-md-4">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="card-title mb-0">Valores Actuales</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <strong>ID:</strong> @originalProductPlan.Id
                                        </div>
                                        <div class="mb-3">
                                            <strong>Artículo ID actual:</strong> @originalProductPlan.ProductId
                                        </div>
                                        <div class="mb-3">
                                            <strong>Plan ID actual:</strong> @originalProductPlan.PlanId
                                        </div>

                                        @if (!string.IsNullOrEmpty(originalProductPlan.ProductName))
                                        {
                                            <div class="mb-3">
                                                <strong>Nombre del Producto:</strong> @originalProductPlan.ProductName
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(originalProductPlan.PlanName))
                                        {
                                            <div class="mb-3">
                                                <strong>Nombre del Plan:</strong> @originalProductPlan.PlanName
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(originalProductPlan.CategoryName))
                                        {
                                            <div class="mb-3">
                                                <strong>Categoría:</strong> @originalProductPlan.CategoryName
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="card mt-3">
                                    <div class="card-header">
                                        <h5 class="card-title mb-0">Acciones</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-grid gap-2">
                                            <button type="button" class="btn btn-outline-primary" @onclick="() => ViewDetails(originalProductPlan.Id)">
                                                <i class="fas fa-eye me-2"></i>Ver Detalles
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" @onclick="() => ConfirmDelete(originalProductPlan.Id)">
                                                <i class="fas fa-trash me-2"></i>Eliminar Relación
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ProductPlanDto? originalProductPlan;
    private UpdateProductPlanDto model = new();
    private bool isLoading = false;
    private bool isLoadingInitial = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private List<ProductDto>? products;
    private List<PlanDto>? plans;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductPlan();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (originalProductPlan?.Id != Id)
        {
            await LoadProductPlan();
        }
    }

    private async Task LoadProductPlan()
    {
        try
        {
            isLoadingInitial = true;
            errorMessage = string.Empty;
            StateHasChanged();

            // Load products and plans concurrently
            var productTask = ProductService.GetAllAsync();
            var planTask = PlanService.GetAllAsync();

            await Task.WhenAll(productTask, planTask);

            var productResponse = await productTask;
            var planResponse = await planTask;

            if (productResponse?.Success == true)
            {
                products = productResponse.Data!.Items ?? new List<ProductDto>();
            }
            else
            {
                products = new List<ProductDto>();
                errorMessage = "Error al cargar los artículos.";
            }

            if (planResponse?.Success == true)
            {
                plans = planResponse.Data.Items ?? new List<PlanDto>();
            }
            else
            {
                plans = new List<PlanDto>();
                if (string.IsNullOrEmpty(errorMessage))
                    errorMessage = "Error al cargar los planes.";
                else
                    errorMessage += " Error al cargar los planes.";
            }

            var response = await ProductPlanService.GetByIdAsync(Id);

            if (response?.Success == true && response.Data != null)
            {
                originalProductPlan = response.Data;
                // Initialize the edit model with current values
                model = new UpdateProductPlanDto
                {
                    ProductId = originalProductPlan.ProductId,
                    PlanId = originalProductPlan.PlanId
                };
            }
            else
            {
                errorMessage = response?.Message ?? "Relación no encontrada.";
                originalProductPlan = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error cargando la relación: {ex.Message}";
            originalProductPlan = null;
        }
        finally
        {
            isLoadingInitial = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidSubmit()
    {
        if (originalProductPlan == null) return;

        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;
            StateHasChanged();

            // Check if the combination already exists (only if values changed)
            if (model.ProductId != originalProductPlan.ProductId || model.PlanId != originalProductPlan.PlanId)
            {
                var existsResponse = await ProductPlanService.CheckExistsAsync(model.PlanId, model.ProductId);
                if (existsResponse?.Success == true && existsResponse.Data == true)
                {
                    errorMessage = "Ya existe esta combinación.";
                    return;
                }
            }

            var response = await ProductPlanService.UpdateAsync(Id, model);

            if (response?.Success == true)
            {
                successMessage = "Artículo/Plan actualizado extosamente";
                await JSRuntime.InvokeVoidAsync("alert", "Artículo / Plan actualizado extosamente");

                // Reload the original data to reflect changes
                await LoadProductPlan();
            }
            else
            {
                errorMessage = response?.Message ?? "Ocurrió un error actualizando la relación";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleInvalidSubmit()
    {
        errorMessage = "Por favor corrija los errores de validación.";
        await Task.CompletedTask;
    }

    private void ResetForm()
    {
        if (originalProductPlan != null)
        {
            model = new UpdateProductPlanDto
            {
                ProductId = originalProductPlan.ProductId,
                PlanId = originalProductPlan.PlanId
            };
        }
        errorMessage = string.Empty;
        successMessage = string.Empty;
        StateHasChanged();
    }

    private void ViewDetails(int id)
    {
        Navigation.NavigateTo($"/productplans/details/{id}");
    }

    private async Task ConfirmDelete(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Querés borrar esta relación? Esta acción no puede ser deshecha.");
        if (confirmed)
        {
            await DeleteProductPlan(id);
        }
    }

    private async Task DeleteProductPlan(int id)
    {
        try
        {
            var response = await ProductPlanService.DeleteAsync(id);

            if (response?.Success == true)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Relación borrada exitosamente!");
                Navigation.NavigateTo("/productplans");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "Un error ocurrió al eliminar el Artículo/Plan");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Un error ocurrió: {ex.Message}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/productplans");
    }
}