@page "/plans/edit/{id:int}"
@using CuentasClaras.Application.DTOs
@using CuentasClaras.Frontend.Services
@inject IPlanService PlanService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Editar Plan</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            @if (loading)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (planFound)
            {
                <div class="card">
                    <div class="card-header">
                        <h3>Editar Plan</h3>
                    </div>
                    <div class="card-body">
                        <EditForm Model="updatePlanDto" OnValidSubmit="HandleValidSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="alert alert-danger" />
                            <div class="mb-3">
                                <label for="name" class="form-label">Nombre *</label>
                                <InputText id="name" class="form-control" @bind-Value="updatePlanDto.Name" />
                                <ValidationMessage For="@(() => updatePlanDto.Name)" />
                            </div>

                            <div class="mb-3">
                                <label for="createDate" class="form-label">Fecha de Creación *</label>
                                <InputDate id="createDate" class="form-control" @bind-Value="updatePlanDto.StartDate" />
                                <ValidationMessage For="@(() => updatePlanDto.StartDate)" />
                            </div>

                            <div class="mb-3">
                                <label for="createDate" class="form-label">Fecha de Finalización *</label>
                                <InputDate id="endDate" class="form-control" @bind-Value="updatePlanDto.EndDate" />
                                <ValidationMessage For="@(() => updatePlanDto.EndDate)" />
                            </div>

                            <div class="mb-3">
                                <label for="name" class="form-label">Tasa de Interés *</label>
                                <InputNumber id="name" class="form-control" @bind-Value="updatePlanDto.InterestRate" />
                                <ValidationMessage For="@(() => updatePlanDto.InterestRate)" />
                            </div>

                             <div class="d-flex justify-content-between">
                                <NavLink type="button" class="btn btn-secondary" href="/plans">
                                    <i class="fas fa-arrow-left"></i> Vuelta a Planes
                                </NavLink>
                                <button type="submit" class="btn btn-primary" disabled="@submitting">
                                    @if (submitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="fas fa-save"></i> Actualizar Plan
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle"></i> Plan no encontrado.
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private UpdatePlanDto updatePlanDto = new();
    private bool loading = true;
    private bool submitting = false;
    private bool planFound = false;

    protected override async Task OnInitializedAsync()
    {
        var result = await PlanService.GetByIdAsync(Id);

        if (result?.Success == true && result.Data != null)
        {
            updatePlanDto.Name = result.Data.Name;
            updatePlanDto.InterestRate = result.Data.InterestRate;
            updatePlanDto.StartDate = result.Data.StartDate;
            updatePlanDto.EndDate = result.Data.EndDate;
            planFound = true;
        }

        loading = false;
    }

    private async Task HandleValidSubmit()
    {
        submitting = true;
        var result = await PlanService.UpdateAsync(Id, updatePlanDto);

        if (result?.Success == true)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Plan actualizado exitosamente!");
            Navigation.NavigateTo("/plans");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error actualizando plan: {result?.Message}");
        }

        submitting = false;
    }
}
