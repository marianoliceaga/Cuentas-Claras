@using Microsoft.AspNetCore.Components.Forms
@using CuentasClaras.Application.DTOs
@using CuentasClaras.Domain
@using CuentasClaras.Frontend.Services
@inject ILocalityService LocalityService
@inject ICollectorService CollectorService
@inject ISalesmanService SalesmanService

<EditForm Model="Model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">DNI <span class="text-danger">*</span></label>
                <InputText @bind-Value="Model.DNI" class="form-control" disabled="@IsLoading" />
                <ValidationMessage For="() => Model.DNI" />
            </div>

            <div class="mb-3">
                <label class="form-label">Nombre <span class="text-danger">*</span></label>
                <InputText @bind-Value="Model.Name" class="form-control" disabled="@IsLoading" />
                <ValidationMessage For="() => Model.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Apellido <span class="text-danger">*</span></label>
                <InputText @bind-Value="Model.LastName" class="form-control" disabled="@IsLoading" />
                <ValidationMessage For="() => Model.LastName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText @bind-Value="Model.Email" type="email" class="form-control" disabled="@IsLoading" />
                <ValidationMessage For="() => Model.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Teléfono 1</label>
                <InputText @bind-Value="Model.Phone1" class="form-control" disabled="@IsLoading" />
                <ValidationMessage For="() => Model.Phone1" />
            </div>

            <div class="mb-3">
                <label class="form-label">Teléfono 2</label>
                <InputText @bind-Value="Model.Phone2" class="form-control" disabled="@IsLoading" />
                <ValidationMessage For="() => Model.Phone2" />
            </div>
        </div>

        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Teléfono 3</label>
                <InputText @bind-Value="Model.Phone3" class="form-control" disabled="@IsLoading" />
                <ValidationMessage For="() => Model.Phone3" />
            </div>

            <div class="mb-3">
                <label class="form-label">Dirección 1</label>
                <InputText @bind-Value="Model.Address1" class="form-control" disabled="@IsLoading" />
                <ValidationMessage For="() => Model.Address1" />
            </div>

            <div class="mb-3">
                <label class="form-label">Dirección 2</label>
                <InputText @bind-Value="Model.Address2" class="form-control" disabled="@IsLoading" />
                <ValidationMessage For="() => Model.Address2" />
            </div>

            <div class="mb-3">
                <label class="form-label">Localidad <span class="text-danger">*</span></label>
                <InputSelect @bind-Value="Model.LocalityId" class="form-control" disabled="@IsLoading">
                    <option value="0">-- Elegir Localidad --</option>
                    @if (localities != null)
                    {
                        @foreach (var locality in localities)
                        {
                            <option value="@locality.Id">@locality.Name</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="() => Model.LocalityId" />
            </div>

            <div class="mb-3">
                <label class="form-label">Cobrador <span class="text-danger">*</span></label>
                <InputSelect @bind-Value="Model.CollectorId" class="form-control" disabled="@IsLoading">
                    <option value="0">-- Elegir Cobrador --</option>
                    @if (collectors != null)
                    {
                        @foreach (var collector in collectors)
                        {
                            <option value="@collector.Id">@collector.Name</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="() => Model.CollectorId" />
            </div>

            <div class="mb-3">
                <label class="form-label">Vendedor <span class="text-danger">*</span></label>
                <InputSelect @bind-Value="Model.SalesmanId" class="form-control" disabled="@IsLoading">
                    <option value="0">-- Elegir Vendedor --</option>
                    @if (salesmen != null)
                    {
                        @foreach (var salesman in salesmen)
                        {
                            <option value="@salesman.Id">@salesman.Name</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="() => Model.SalesmanId" />
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" @onclick="OnCancel" disabled="@IsLoading">
            Cancelar
        </button>
        <button type="submit" class="btn btn-primary" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            Actualizar Cliente
        </button>
    </div>
</EditForm>

@code {
    [Parameter] public UpdateCustomerRequest Model { get; set; } = new();
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private List<Locality>? localities;
    private List<CollectorDto>? collectors;
    private List<SalesmanDto>? salesmen;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
    }

    private async Task LoadLookupData()
    {
        try
        {
            localities = await LocalityService.GetAllLocalitiesAsync();
            collectors = (await CollectorService.GetAllAsync()).ToList();
            salesmen = (await SalesmanService.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            // Log the error or handle it appropriately
            Console.WriteLine($"Error cargando datos de lookup: {ex.Message}");
        }
    }
}