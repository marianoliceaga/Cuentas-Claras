@page "/customers/create"
@using CuentasClaras.Application.DTOs
@using CuentasClaras.Frontend.Services
@inject ICustomerService CustomerService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Crear Cliente</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Nuevo Cliente</h3>
    <button class="btn btn-secondary" @onclick="GoBack">
        <i class="fas fa-arrow-left"></i> Volver a la lista
    </button>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <CustomerCreateForm Model="createRequest" 
                                  OnValidSubmit="HandleValidSubmit" 
                                  OnCancel="GoBack"
                                  IsLoading="isLoading" />
            </div>
        </div>
    </div>
</div>

@code {
    private CreateCustomerRequest createRequest = new();
    private bool isLoading = false;

    private async Task HandleValidSubmit()
    {
        isLoading = true;
        
        try
        {
            // Check if DNI already exists
            var dniExists = await CustomerService.CustomerExistsByDNIAsync(createRequest.DNI);
            if (dniExists)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Ya existe un cliente con este DNI.");
                isLoading = false;
                return;
            }

            await CustomerService.CreateCustomerAsync(createRequest);
            Navigation.NavigateTo("/customers");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error creando cliente: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/customers");
}
