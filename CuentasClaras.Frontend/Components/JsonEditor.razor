@using System.Text.Json.Nodes
@using System.Text.Json

@if (Node is JsonObject obj)
{
    <div class="ms-3 border p-2 rounded">
        <strong>Características</strong>

        @foreach (var kv in obj.ToList())
        {
            <div class="d-flex mb-2">
                <input class="form-control me-2" style="max-width:150px"
                       value="@kv.Key"
                       @onchange="e => RenameKey(obj, kv.Key, e.Value?.ToString())" />

                <JsonEditor Node="kv.Value!" OnChanged="TriggerChanged" />

                <button type="button" class="btn btn-sm btn-danger ms-2"
                        @onclick="@(() => { obj.Remove(kv.Key); TriggerChanged(); })">
                    X
                </button>
            </div>
        }

        <!-- ✅ FIX: call a method instead of inline code with ["..."] -->
        <button type="button" class="btn btn-sm btn-secondary mt-1"
                @onclick="@(() => AddProperty(obj))">
            + Propiedad
        </button>
    </div>
}
@* else if (Node is JsonArray arr)
{
    <div class="ms-3 border p-2 rounded">
        <strong>Arreglo</strong>

        @for (int i = 0; i < arr.Count; i++)
        {
            var index = i;
            <!-- this is the trick -->
            <div class="d-flex mb-2">
                <JsonEditor Node="arr[i]!" OnChanged="TriggerChanged" />
                <button type="button" class="btn btn-sm btn-danger ms-2"
